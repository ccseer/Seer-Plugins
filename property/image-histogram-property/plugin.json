{
  "schema_version": 1,
  "id": "io.1218.seer.image-histogram",
  "name": "RGB Histogram",
  "description": "Computes RGB histograms and exposure statistics for supported image formats.",
  "version": "1.0.0",
  "appMinVersion": "4.5.10",
  "backend": "process",
  "capabilities": ["property"],
  "extensions": ["png", "jpg", "jpeg", "bmp", "webp", "tif", "tiff"],
  "invocations": {
    "property": {
      "command": "image_histogram.exe",
      "arguments": ["--input", "${input_file}", "--output", "${output_file}", "--output-dir", "${output_dir}"],
      "result_schema": 1,
      "timeout_ms": 30000,
      "success_exit_codes": [0]
    }
  }
}
